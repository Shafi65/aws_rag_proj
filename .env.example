# Copy to .env and adjust. .env is gitignored; this file is not.
# Nothing here is a secret -- AWS credentials come from `aws configure`
# (~/.aws/credentials), which boto3 picks up on its own.

# ---------- AWS ----------
AWS_REGION=us-east-1
S3_BUCKET=your-bucket-name
S3_PREFIX=

# ---------- Postgres ----------
# Port 5433 matches the host-side mapping in docker-compose.yml.
PGHOST=localhost
PGPORT=5433
PGDATABASE=ragdb
PGUSER=rag
PGPASSWORD=rag

# ---------- Models ----------
# Titan Text Embeddings v2. Output dimension is baked into the vector(1024)
# column in schema.sql -- changing EMBEDDING_DIM requires a schema migration,
# not just an edit here.
EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
EMBEDDING_DIM=1024

# Filled in during Phase 2. We list what this AWS account actually has access
# to rather than guessing an ID, because Bedrock model availability varies by
# account and region and a wrong ID is an unhelpful AccessDenied.
GENERATION_MODEL_ID=
RERANK_MODEL_ID=

# ---------- Chunking ----------
# Measured in CHARACTERS, not tokens. There is no public tokenizer for Titan,
# so counting tokens locally would mean guessing. Characters are exact and
# reproducible; the rough conversion is ~4 characters per token, so 1200 chars
# is roughly 300 tokens. We tune these against the eval harness in Phase 7.
CHUNK_SIZE_CHARS=1200
CHUNK_OVERLAP_CHARS=200

# ---------- Retrieval ----------
# How many candidates vector search returns before reranking (stage one),
# and how many survive reranking and go into the prompt (stage two).
CANDIDATE_K=20
FINAL_K=5
