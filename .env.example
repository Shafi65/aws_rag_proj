# Copy to .env and adjust. .env is gitignored; this file is not.
# Nothing here is a secret -- AWS credentials come from `aws configure`
# (~/.aws/credentials), which boto3 picks up on its own.

# ---------- AWS ----------
AWS_REGION=us-east-1
S3_BUCKET=your-bucket-name
S3_PREFIX=

# ---------- Postgres ----------
# Port 5433 matches the host-side mapping in docker-compose.yml.
PGHOST=localhost
PGPORT=5433
PGDATABASE=ragdb
PGUSER=rag
PGPASSWORD=rag

# ---------- Models ----------
# Titan Text Embeddings v2. Output dimension is baked into the vector(1024)
# column in schema.sql -- changing EMBEDDING_DIM requires a schema migration,
# not just an edit here.
EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
EMBEDDING_DIM=1024

# Generation. Note the "us." prefix: this is an INFERENCE PROFILE, not a bare
# model ID. Newer Bedrock models pool on-demand capacity across regions, and
# invoking the bare model ID fails with "on-demand throughput isn't supported".
# "us." keeps requests inside US regions; a "global." profile also exists and
# has better availability, but routes worldwide -- a data-residency question,
# not just a performance one.
#
# Nova Lite is the default because Anthropic models on Bedrock additionally
# require a one-time use-case form to be submitted in the console. Once that
# clears, swapping to Claude is this line and nothing else -- which is the
# whole point of using the Converse API rather than model-specific payloads:
#   GENERATION_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
GENERATION_MODEL_ID=us.amazon.nova-lite-v1:0

# Reranking (Phase 5). Confirmed available in us-east-1. Note this is called
# through a third boto3 client, bedrock-agent-runtime, not bedrock-runtime.
RERANK_MODEL_ID=cohere.rerank-v3-5:0

# ---------- Chunking ----------
# Measured in CHARACTERS, not tokens. There is no public tokenizer for Titan,
# so counting tokens locally would mean guessing. Characters are exact and
# reproducible; the rough conversion is ~4 characters per token, so 1200 chars
# is roughly 300 tokens. We tune these against the eval harness in Phase 7.
CHUNK_SIZE_CHARS=1200
CHUNK_OVERLAP_CHARS=200

# ---------- Retrieval ----------
# How many candidates vector search returns before reranking (stage one),
# and how many survive reranking and go into the prompt (stage two).
CANDIDATE_K=20
FINAL_K=5
